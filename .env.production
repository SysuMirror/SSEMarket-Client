# 生产构建专用（npm run build 时自动使用）
# 使用相对路径，使 IP:端口直连与域名访问都走当前来源（origin）
VITE_API_BASE_URL=/api
VITE_OPSAGENT_BASE_URL=

# 阶段2 灰度：集市发帖 AI 应答
# 灰度期间 = true（逻辑编入产物，可见性由 src/config/assist.ts 白名单+localStorage 后门控制）
VITE_ASSIST_ENABLED=true
VITE_ASSIST_BASE_URL=/api/v1/assist
VITE_DIGEST_PREF_ENABLED=true

# 集市 App 下载：生产环境安装包（文件由主站 /new/downloads/ 托管）。
# 目前发布 Android / Windows / Linux；iOS、macOS、鸿蒙 NEXT（HAP 未签名）暂未提供。
VITE_APP_DOWNLOAD_ANDROID=https://ssemarket.cn/new/downloads/ssemarket-android-arm64-v8a-0.6.7+18.apk
VITE_APP_DOWNLOAD_HARMONY=
VITE_APP_DOWNLOAD_WINDOWS=https://ssemarket.cn/new/downloads/sse-market-windows-x64-setup-20261116e.exe
VITE_APP_DOWNLOAD_LINUX=https://ssemarket.cn/new/downloads/sse-market-linux-x64-0.6.6+17.tar.gz

# Evia 埋点上报（生产环境指向 evo.ssemarket.cn 的 production 来源）
VITE_EVIA_ENDPOINT=https://evo.ssemarket.cn
VITE_EVIA_PROJECT_ID=9638bef9-fecf-4a34-a3e9-16a31c260a16
VITE_EVIA_ENV=production
VITE_EVIA_WRITE_KEY=evia_w_K8NCaLZ1Mh0YmdodKp2j-b5BqQkt0LLUhR4KgBWk3lg

# 内容加密公钥默认由签名配置 /v1/config 自动下发；以下仅作回退覆盖
VITE_EVIA_CONTENT_KEY_ID=
VITE_EVIA_CONTENT_PUBLIC_JWK_B64=

VITE_EVIA_CONFIG_SIGNING_KEY_ID=evia-cfg-v1
VITE_EVIA_CONFIG_SIGNING_PUBLIC_JWK_B64=eyJrdHkiOiJPS1AiLCJjcnYiOiJFZDI1NTE5IiwieCI6Imo3ME1uMXdRbGhkc0FZR1JjV2xkMDc1VDJ6OXZsQTJQQlZMNmJqeWVHQmMifQ

# 会话回放按环境灰度采样（20%，单会话明文压缩后最多 2 MiB、硬上限 8 MiB）
VITE_EVIA_REPLAY_SAMPLE_RATE=0.2
VITE_EVIA_REPLAY_MAX_BYTES=2097152
