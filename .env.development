# 本地开发默认走生产 API；压测调试请临时改为下一行并勿提交
VITE_API_BASE_URL=https://ssemarket.cn/api
VITE_OPSAGENT_BASE_URL=https://ssemarket.cn
# VITE_API_BASE_URL=https://ssemarket.cn/loadtest/api

# 阶段2 灰度：集市发帖 AI 应答（本地开发默认开启；生产见 .env.production）
VITE_ASSIST_ENABLED=true
VITE_ASSIST_BASE_URL=/api/v1/assist

# 集市 App 下载：本地开发指向多端测试包服务器（生产包见 .env.production）。
# 目前发布 Android / Windows / Linux；iOS、macOS、鸿蒙 NEXT（HAP 未签名）暂未提供。
VITE_APP_DOWNLOAD_ANDROID=https://ssemarket.cn:23030/ssemarket-android-arm64-v8a-0.6.7+18.apk?v=2026111606
VITE_APP_DOWNLOAD_HARMONY=
VITE_APP_DOWNLOAD_WINDOWS=https://ssemarket.cn:23030/sse-market-windows-x64-setup-20261116e.exe?v=2026111607
VITE_APP_DOWNLOAD_LINUX=https://ssemarket.cn:23030/sse-market-linux-x64-0.6.6+17.tar.gz?v=20261115e

# Evia 埋点上报（开发/测试环境指向 evo.ssemarket.cn；如需改连本机 Evia 请放 .env.development.local）
VITE_EVIA_ENDPOINT=https://evo.ssemarket.cn
VITE_EVIA_PROJECT_ID=9638bef9-fecf-4a34-a3e9-16a31c260a16
VITE_EVIA_ENV=development
VITE_EVIA_WRITE_KEY=evia_w_8tl9Ln6Z6-mia0voUv5FOwfNg0g3tQw9kBwjf1gR5Qw

# 内容加密公钥默认由签名配置 /v1/config 自动下发；以下仅作回退覆盖
VITE_EVIA_CONTENT_KEY_ID=
VITE_EVIA_CONTENT_PUBLIC_JWK_B64=

VITE_EVIA_CONFIG_SIGNING_KEY_ID=evia-cfg-v1
VITE_EVIA_CONFIG_SIGNING_PUBLIC_JWK_B64=eyJrdHkiOiJPS1AiLCJjcnYiOiJFZDI1NTE5IiwieCI6Imo3ME1uMXdRbGhkc0FZR1JjV2xkMDc1VDJ6OXZsQTJQQlZMNmJqeWVHQmMifQ

# 会话回放：开发环境全量采样便于联调，单会话明文压缩后最多 2 MiB（硬上限 8 MiB）
VITE_EVIA_REPLAY_SAMPLE_RATE=1
VITE_EVIA_REPLAY_MAX_BYTES=2097152
